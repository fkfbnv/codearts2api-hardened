{
  // 本文件可直接 `cp config.example.json config.json` 使用：// 与 /* */ 注释会被忽略。
  // api_key 必填（也可用环境变量 CA2A_API_KEY）：没有 key 服务会拒绝启动。
  // 生成：openssl rand -hex 24
  "api_key": "",
  "listen": ":7866",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "default_model": "snap-chat",
  "oauth_callback_host": "",
  "cooldown": {
    "soft_rate": "60s",
    "err_threshold": 3,
    "err_cooldown": "10m"
  },
  "benefit_auto_claim": true,    // 模型发现时自动领取限时福利（幂等；关闭则福利模型调用必然失败）
  "credits_auto_claim": true,    // watchdog 自动领取每日签到/新手活动积分；与模型 Token 福利独立
  // "login_client_id": "codearts-agent",  // WebUI 登录用 OAuth client；留空自动沿用已有账号的取值
  "max_concurrent": 5,           // 单账号最大并发数（默认 5）
  "upstream_max_body_mb": 10,    // 发往上游 chat-completions 的请求体上限（默认 10；上游实测硬上限 10MiB）
  "keepalive_window": "10m",     // 保活心跳窗口，超过此时间无活动则发送心跳（默认 10m）
  "watch": {
    "enabled": true,
    "poll_minutes": 30,
    "refresh_skew_minutes": 30,
    "keepalive_interval_minutes": 15  // 保活心跳间隔（新增，默认 15m）
  },
  "upstream": {
    "timeout_seconds": 120
  },
  // 官方 CLI 后端：直连对部分模型已无权（TM.000010051），命中 models 的请求
  // 转给本地 codearts serve。codearts_exe 必须写你机器上的实际安装路径，
  // 也可用环境变量 CA2A_CLI_EXE 覆盖；留空则 CLI 后端无法启动。
  "cli_backend": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:4096",
    "provider": "huaweicloud-maas",
    "agent": "build",
    "codearts_exe": "",
    "credentials_file": "./cli-credentials.json",
    "timeout_seconds": 300,
    "models": {
      "deepseek-v4.1-flash": "deepseek-v4.1-flash",
      "deepseek-v4.1-flash-1017": "deepseek-v4.1-flash-1017",
      "glm-5.3": "glm-5.3",
      "glm-5.3-flash": "glm-5.3-flash",
      "kimi-k3": "kimi-k3",
      "kimi-k3.1-pro": "kimi-k3.1-pro",
      "openpangu-2.0-flash": "openpangu-2.0-flash",
      "openpangu-2.0-pro": "openpangu-2.0-pro"
    }
  }
}
